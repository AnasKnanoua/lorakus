# Sauvegarde quotidienne de la production (declenchee par lorakus-backup.timer).
# Installation : voir DEPLOYMENT.md, section 7.
[Unit]
Description=Lorakus : sauvegarde chiffree de la base vers B2
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/opt/lorakus/app/infra/deploy/deploy.sh backup
# Attente eventuelle d'un deploiement (30 min) + duree de la sauvegarde.
TimeoutStartSec=45min
# Protections de base. deploy appartient au groupe docker : ce n'est pas un vrai bac a sable.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
