# Modele de configuration Alertmanager. Le marqueur __..__ est remplace au
# demarrage du conteneur par la valeur de .env : aucun secret dans le depot.
# Canal d'EXPLOITATION uniquement (ADR 0035) : jamais de notification produit ici.
route:
  receiver: discord-ops
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: discord-ops
    discord_configs:
      - webhook_url: "__DISCORD_OPS_WEBHOOK_URL__"
        send_resolved: true
        title: '{{ template "lorakus.title" . }}'
        message: '{{ template "lorakus.message" . }}'

templates:
  - /etc/alertmanager/templates/*.tmpl

# Une alerte critique masque les avertissements du MEME composant (api, backup, host) :
# un disque plein ne doit pas faire taire un echec de sauvegarde.
inhibit_rules:
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: [component]
