# Modele des variables d'environnement.
# Copie en .env (jamais commite), puis chaque "change-me" remplace par une valeur
# aleatoire : openssl rand -hex 24

# --- PostgreSQL ---
POSTGRES_DB=lorakus
POSTGRES_USER=lorakus_admin
POSTGRES_PASSWORD=change-me
LORAKUS_MIGRATOR_DB_PASSWORD=change-me
LORAKUS_APP_DB_PASSWORD=change-me

# --- Observabilite ---
GRAFANA_ADMIN_PASSWORD=change-me
