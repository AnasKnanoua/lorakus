# Modele des variables d'environnement.
# Copie en .env (jamais commite, chmod 600), puis chaque "change-me" remplace par
# une valeur aleatoire : openssl rand -hex 24

# --- PostgreSQL ---
POSTGRES_DB=lorakus
POSTGRES_USER=lorakus_admin
POSTGRES_PASSWORD=change-me
LORAKUS_MIGRATOR_DB_PASSWORD=change-me
LORAKUS_APP_DB_PASSWORD=change-me

# --- Observabilite ---
GRAFANA_ADMIN_PASSWORD=change-me

# --- Alertes d'EXPLOITATION : webhook Discord du salon #lorakus-infra (ADR 0035) ---
DISCORD_OPS_WEBHOOK_URL=change-me

# --- Notifications PRODUIT : bot Telegram (utilise a partir de la phase 5, ADR 0035) ---
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_CHAT_ID=0

# --- Sauvegardes : cle B2 limitee (sans droit de suppression) et cle PUBLIQUE age ---
# Une cle B2 par machine (DEPLOYMENT.md, section 7.2). Sur le poste de developpement : cle en
# lecture seule pour make restore-test ; make backup demande un bucket d'essai distinct.
# La cle PRIVEE age n'est jamais ici : elle reste dans le gestionnaire de mots de passe.
B2_KEY_ID=change-me
B2_APP_KEY=change-me
B2_BUCKET=change-me
BACKUP_AGE_RECIPIENT=change-me

# --- Sentinelle externe (ADR 0037) : production uniquement, saisie par infra/deploy/init-env.sh ---
# Inutile en developpement : le signal de vie n'y est envoye nulle part.
# HEALTHCHECKS_PING_URL=https://hc-ping.com/<uuid>

# --- Moteur IA (ADR 0007, D-D) ---
# Sans cle, en developpement, un faux fournisseur repond par echo (jamais en staging ni en production).
# LORAKUS_ANTHROPIC_API_KEY=
# Plafond par utilisateur et par mois (dollars) ; coupure generale en cas d'incident.
# LORAKUS_AI_MONTHLY_BUDGET_USD=3.00
# LORAKUS_AI_KILL_SWITCH=false

# --- Chiffrement des secrets TOTP (64 caracteres hexadecimaux) ---
# Facultative en developpement. Pour l'activer : python3 -c 'import secrets; print(secrets.token_hex(32))'
# LORAKUS_FIELD_ENCRYPTION_KEY=

# --- Exposition publique (PR 35, ADR 0038) : production seulement ---
# Nom public servi par Caddy (defaut dans compose.prod.yml : app.lorakus.app). A changer
# seulement pour une autre installation ; le DNS doit pointer vers le serveur.
# LORAKUS_PUBLIC_HOST=app.lorakus.app
