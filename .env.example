# Modele des variables d'environnement.
# Copie en .env (jamais commite, chmod 600), puis chaque "change-me" remplace par
# une valeur aleatoire : openssl rand -hex 24

# --- PostgreSQL ---
POSTGRES_DB=lorakus
POSTGRES_USER=lorakus_admin
POSTGRES_PASSWORD=change-me
LORAKUS_MIGRATOR_DB_PASSWORD=change-me
LORAKUS_APP_DB_PASSWORD=change-me

# --- Observabilite ---
GRAFANA_ADMIN_PASSWORD=change-me

# --- Alertes d'EXPLOITATION : webhook Discord du salon #lorakus-infra (ADR 0035) ---
DISCORD_OPS_WEBHOOK_URL=change-me

# --- Notifications PRODUIT : bot Telegram (utilise a partir de la phase 5, ADR 0035) ---
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_CHAT_ID=0

# --- Sauvegardes : cle B2 limitee (sans droit de suppression) et cle PUBLIQUE age ---
# La cle PRIVEE age n'est jamais ici : elle reste dans le gestionnaire de mots de passe.
B2_KEY_ID=change-me
B2_APP_KEY=change-me
B2_BUCKET=change-me
BACKUP_AGE_RECIPIENT=change-me
